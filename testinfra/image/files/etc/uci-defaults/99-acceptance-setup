#!/bin/sh
# First-boot configuration for the acceptance-test VM.
#
# Topology: eth0=wan, eth1=lan (mgmt, host-reachable), eth2-eth5=spare.
# eth2-eth5 are intentionally left unconfigured so bridge/VLAN/network_device
# acceptance tests have a clean slate to attach to.

# --- root password ---
# Acceptance tests authenticate over JSON-RPC as root/root.
(echo "root"; sleep 1; echo "root") | passwd root >/dev/null 2>&1

# --- network ---
uci -q delete network.lan
uci -q delete network.wan

uci set network.lan=interface
uci set network.lan.device='eth1'
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.56.2'
uci set network.lan.netmask='255.255.255.0'

uci set network.wan=interface
uci set network.wan.device='eth0'
uci set network.wan.proto='dhcp'

uci commit network

# --- wireless: populate /etc/config/wireless for the hwsim radios ---
wifi config

exit 0
